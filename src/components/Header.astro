---
import {
  useTranslations,
  getLocalizedPath,
} from "../i18n/translations";

interface Props {
  lang?: "fr" | "en";
}

const { lang = "fr" } = Astro.props;
const t = useTranslations(lang);
const otherLang = lang === "fr" ? "en" : "fr";

const currentPath = Astro.url.pathname.replace(/^\/pachatopia/, "") || "/";
const pathWithoutLang = currentPath.replace(/^\/en/, "") || "/";
const switchLangPath = "/pachatopia" + getLocalizedPath(pathWithoutLang, otherLang);

const base = "/pachatopia";

// Primary nav items (shown in desktop bar)
const primaryNav = [
  { key: "nav.home" as const, href: base + getLocalizedPath("/", lang) },
  { key: "nav.vision" as const, href: base + getLocalizedPath("/a-propos-de-nous/", lang) },
  { key: "nav.history" as const, href: base + getLocalizedPath("/notre-histoire/", lang) },
  { key: "nav.actions" as const, href: base + getLocalizedPath("/nos-actions/", lang) },
  { key: "nav.coffee" as const, href: base + getLocalizedPath("/le-cafe/", lang) },
];

// Participer dropdown items
const participerNav = [
  { key: "nav.passeport" as const, href: base + getLocalizedPath("/passeport/", lang) },
  { key: "nav.parrainage" as const, href: base + getLocalizedPath("/parrainer-une-culture/", lang) },
  { key: "nav.parrainage_espaces" as const, href: base + getLocalizedPath("/espaces-de-liberte/", lang) },
  { key: "nav.partenaire" as const, href: base + getLocalizedPath("/devenir-partenaire/", lang) },
  { key: "nav.ambassadeur" as const, href: base + getLocalizedPath("/devenir-ambassadeur/", lang), indent: true },
  { key: "nav.depots_ventes" as const, href: base + getLocalizedPath("/livraison-retrait/", lang), indent: true },
  { key: "nav.volontariat" as const, href: base + getLocalizedPath("/participer-volontariat/", lang) },
];

const homeHref = base + getLocalizedPath("/", lang);
const participateHref = base + getLocalizedPath("/trouver-sa-place/", lang);
---

<header
  data-testid="header"
  id="main-header"
  class="fixed top-0 left-0 right-0 z-50 transition-all duration-300"
>
  <!-- Top bar -->
  <div class="bg-primary/95 backdrop-blur-md border-b border-white/[0.08]">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="flex items-center justify-between h-16">
        
        <!-- Logo -->
        <a href={homeHref} class="flex items-center gap-3 shrink-0 group">
          <img
            src="/pachatopia/images/logoo.png"
            alt="Pachatopia logo"
            class="h-10 w-auto transition-transform duration-300 group-hover:scale-105"
          />
          <span class="hidden sm:block font-heading text-lg font-bold text-white tracking-wide">
            Pachatopia
          </span>
        </a>

        <!-- Desktop navigation -->
        <nav class="hidden lg:flex items-center gap-1" aria-label="Navigation principale">
          {primaryNav.map((item) => (
            <a
              href={item.href}
              class="relative px-3 py-2 text-sm font-medium text-white/80 rounded-lg transition-all duration-200 hover:text-white hover:bg-white/[0.07]"
            >
              {t(item.key)}
            </a>
          ))}
          
          <!-- More dropdown -->
          <div class="relative group">
            <a
              href={participateHref}
              class="flex items-center gap-1 px-3 py-2 text-sm font-medium text-white/80 rounded-lg transition-all duration-200 hover:text-white hover:bg-white/[0.07]"
            >
              <span>{t("nav.support")}</span>
              <svg class="w-3.5 h-3.5 opacity-60 transition-transform group-hover:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <path d="m6 9 6 6 6-6"/>
              </svg>
            </a>
            <!-- Dropdown -->
            <div class="absolute top-full right-0 mt-1 w-72 bg-white rounded-xl shadow-2xl border border-gray-100 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 py-2 z-50">
              {participerNav.map((item) => (
                <a
                  href={item.href}
                  class:list={[
                    "block py-2.5 text-sm text-gray-700 hover:bg-cream hover:text-primary transition-colors",
                    item.indent ? "px-8 text-gray-600" : "px-4",
                  ]}
                >
                  {item.indent ? "↳ " : ""}{t(item.key)}
                </a>
              ))}
            </div>
          </div>

          <!-- Contact -->
          <a
            href={base + getLocalizedPath("/contacts/", lang)}
            class="relative px-3 py-2 text-sm font-medium text-white/80 rounded-lg transition-all duration-200 hover:text-white hover:bg-white/[0.07]"
          >
            {t("nav.contact")}
          </a>
        </nav>

        <!-- Right side: CTA + Language -->
        <div class="flex items-center gap-3">
          <!-- CTA button (desktop) -->
          <a
            href={base + getLocalizedPath("/comment-participer/", lang)}
            class="hidden sm:inline-flex items-center gap-1.5 bg-golden hover:bg-golden-dark text-primary font-semibold text-sm px-4 py-2 rounded-full transition-all duration-200 hover:shadow-lg hover:shadow-golden/20"
          >
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 2C12 2 18 7 18 13C18 17 15 20 12 20C9 20 6 17 6 13C6 7 12 2 12 2Z"/></svg>
            <span>{t("footer.support")}</span>
          </a>

          <!-- Language switch -->
          <a
            data-testid="language-switcher"
            href={switchLangPath}
            class="flex items-center gap-1 rounded-full border border-white/20 px-2.5 py-1.5 text-xs font-semibold text-white/70 transition-all duration-200 hover:border-white/50 hover:text-white hover:bg-white/5"
            aria-label={`Switch language to ${otherLang === "en" ? "English" : "Français"}`}
          >
            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="10"/><path d="M2 12h20"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>
            </svg>
            <span class={lang === "fr" ? "text-white" : ""}>FR</span>
            <span class="opacity-40">|</span>
            <span class={lang === "en" ? "text-white" : ""}>EN</span>
          </a>

          <!-- Hamburger (mobile) -->
          <button
            data-testid="mobile-menu-button"
            id="sidebar-toggle"
            type="button"
            class="lg:hidden inline-flex items-center justify-center rounded-lg p-2 text-white/85 hover:bg-white/10 hover:text-white transition-colors"
            aria-expanded="false"
            aria-controls="sidebar-menu"
            aria-label="Toggle navigation menu"
          >
            <svg id="hamburger-icon" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5"/>
            </svg>
          </button>
        </div>
      </div>
    </div>
  </div>
</header>

<!-- Sidebar Overlay -->
<div
  id="sidebar-overlay"
  class="fixed inset-0 z-50 bg-black/50 backdrop-blur-sm opacity-0 pointer-events-none transition-opacity duration-300"
  aria-hidden="true"
></div>

<!-- Mobile Sidebar -->
<aside
  id="sidebar-menu"
  class="fixed top-0 left-0 z-50 h-full w-80 bg-gradient-to-b from-primary via-primary to-primary-dark transform -translate-x-full transition-transform duration-300 ease-in-out overflow-y-auto"
  aria-label="Main navigation"
>
  <div class="flex items-center justify-between px-5 py-5 border-b border-white/[0.08]">
    <a href={homeHref} class="flex items-center gap-2.5">
      <img src="/pachatopia/images/logoo.png" alt="Pachatopia logo" class="h-9 w-auto"/>
      <span class="font-heading font-bold text-white text-lg">Pachatopia</span>
    </a>
    <button id="sidebar-close" type="button" class="rounded-lg p-2 text-white/60 hover:bg-white/10 hover:text-white transition-colors" aria-label="Close navigation menu">
      <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
      </svg>
    </button>
  </div>

  <nav class="px-4 py-6">
    <!-- Section: Découvrir -->
    <p class="px-3 mb-2 text-xs font-semibold uppercase tracking-[0.2em] text-golden/70">
      {t("footer.discover")}
    </p>
    <ul class="flex flex-col gap-0.5 mb-6">
      {primaryNav.map((item) => (
        <li>
          <a href={item.href} class="sidebar-nav-link flex items-center gap-3 rounded-lg px-3 py-2.5 text-base text-white/80 hover:bg-white/[0.06] hover:text-white transition-colors">
            <span class="w-1.5 h-1.5 rounded-full bg-golden/50"></span>
            {t(item.key)}
          </a>
        </li>
      ))}
    </ul>

    <!-- Section: Participer -->
    <p class="px-3 mb-2 text-xs font-semibold uppercase tracking-[0.2em] text-golden/70">
      {t("footer.participate")}
    </p>
    <ul class="flex flex-col gap-0.5 mb-6">
      {participerNav.map((item) => (
        <li>
          <a
            href={item.href}
            class:list={[
              "sidebar-nav-link flex items-center gap-3 rounded-lg py-2.5 text-base text-white/80 hover:bg-white/[0.06] hover:text-white transition-colors",
              item.indent ? "pl-7 pr-3 text-sm text-white/65" : "px-3",
            ]}
          >
            <span class:list={[
              "rounded-full bg-white/20",
              item.indent ? "w-1 h-1" : "w-1.5 h-1.5",
            ]}></span>
            {t(item.key)}
          </a>
        </li>
      ))}
    </ul>

    <!-- Section: Contact -->
    <p class="px-3 mb-2 text-xs font-semibold uppercase tracking-[0.2em] text-golden/70">
      {t("nav.contact")}
    </p>
    <ul class="flex flex-col gap-0.5">
      <li>
        <a href={base + getLocalizedPath("/contacts/", lang)} class="sidebar-nav-link flex items-center gap-3 rounded-lg px-3 py-2.5 text-base text-white/80 hover:bg-white/[0.06] hover:text-white transition-colors">
          <span class="w-1.5 h-1.5 rounded-full bg-golden/50"></span>
          {t("nav.contact")}
        </a>
      </li>
    </ul>

    <!-- Language switcher -->
    <div class="mt-6 pt-5 border-t border-white/[0.08]">
      <a href={switchLangPath} class="inline-flex items-center gap-2 rounded-full border border-white/20 px-4 py-2.5 text-sm font-medium text-white hover:border-white/50 hover:bg-white/5 transition-all">
        <svg class="w-4 h-4 opacity-60" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="12" cy="12" r="10"/><path d="M2 12h20"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>
        </svg>
        {otherLang === "en" ? "Switch to English" : "Passer en Français"}
      </a>
    </div>
  </nav>
</aside>

<div class="h-16"></div>

<script>
  function initHeader() {
    const sidebarToggle = document.getElementById("sidebar-toggle");
    const sidebarClose = document.getElementById("sidebar-close");
    const sidebar = document.getElementById("sidebar-menu");
    const overlay = document.getElementById("sidebar-overlay");
    const header = document.getElementById("main-header");

    if (!sidebarToggle || !sidebarClose || !sidebar || !overlay) return;

    let isOpen = false;

    function openSidebar() {
      isOpen = true;
      sidebar!.classList.remove("-translate-x-full");
      sidebar!.classList.add("translate-x-0");
      overlay!.classList.remove("opacity-0", "pointer-events-none");
      overlay!.classList.add("opacity-100", "pointer-events-auto");
      sidebarToggle!.setAttribute("aria-expanded", "true");
      document.body.style.overflow = "hidden";
    }

    function closeSidebar() {
      isOpen = false;
      sidebar!.classList.remove("translate-x-0");
      sidebar!.classList.add("-translate-x-full");
      overlay!.classList.remove("opacity-100", "pointer-events-auto");
      overlay!.classList.add("opacity-0", "pointer-events-none");
      sidebarToggle!.setAttribute("aria-expanded", "false");
      document.body.style.overflow = "";
    }

    sidebarToggle.addEventListener("click", () => isOpen ? closeSidebar() : openSidebar());
    sidebarClose.addEventListener("click", closeSidebar);
    overlay.addEventListener("click", closeSidebar);
    sidebar.querySelectorAll(".sidebar-nav-link").forEach((link) => {
      link.addEventListener("click", closeSidebar);
    });
    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && isOpen) { closeSidebar(); sidebarToggle.focus(); }
    });

    function handleScroll() {
      if (header) {
        if (window.scrollY > 10) {
          header.querySelector('.bg-primary\\/95')?.classList.add("shadow-lg", "shadow-black/20");
        } else {
          header.querySelector('.bg-primary\\/95')?.classList.remove("shadow-lg", "shadow-black/20");
        }
      }
    }
    window.addEventListener("scroll", handleScroll, { passive: true });
  }

  document.addEventListener("astro:page-load", initHeader);
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initHeader);
  } else {
    initHeader();
  }
</script>
