---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import LucideIcon from "../components/LucideIcon.astro";

const lang = "fr";

const participationOptions = [
  {
    icon: "Ticket",
    title: "Devenir Gardien du Vivant",
    text: "Le Passeport Pachatopia est une invitation à rejoindre durablement le Mouvement. Il symbolise votre engagement auprès du vivant et vous relie à une communauté de femmes et d'hommes qui choisissent d'agir ensemble.",
    href: "/pachatopia/passeport/",
    link: "Découvrir le Passeport",
  },
  {
    icon: "Coffee",
    title: "Parrainer une culture",
    text: "Derrière chaque récolte, il y a une terre, un producteur, une histoire et du temps. Parrainer une culture, c'est accompagner une transition agroforestière et créer un lien durable.",
    href: "/pachatopia/parrainer-une-culture/",
    link: "Découvrir le parrainage",
  },
  {
    icon: "Trees",
    title: "Parrainer un espace de liberté",
    text: "Une forêt n'est pas seulement un paysage. C'est un refuge, une source d'eau et un équilibre fragile. Votre soutien aide les forêts, les rivières et les animaux à continuer d'évoluer librement.",
    href: "/pachatopia/espaces-de-liberte/",
    link: "Parrainer un espace",
  },
  {
    icon: "Handshake",
    title: "Devenir partenaire",
    text: "Entreprises, fondations, collectivités, associations, écoles, chercheurs ou entrepreneurs peuvent mettre leurs compétences au service du vivant et donner au projet une assise durable.",
    href: "/pachatopia/devenir-partenaire/",
    link: "Construisons un partenariat",
  },
  {
    icon: "TentTree",
    title: "Devenir Volontaire",
    text: "Certaines choses ne s'expliquent pas. Elles se vivent. Venir à Pachatopia, c'est découvrir un laboratoire du vivant en mouvement et repartir avec un autre regard.",
    href: "/pachatopia/participer-volontariat/",
    link: "Découvrir le volontariat",
  },
  {
    icon: "Megaphone",
    title: "Devenir ambassadeur",
    text: "Une idée prend toute sa force lorsqu'elle commence à voyager. Partager un café, organiser une rencontre ou présenter le Mouvement peut faire naître de nouveaux passages vers le vivant.",
    href: "/pachatopia/devenir-ambassadeur/",
    link: "Devenir ambassadeur",
  },
];

const principles = [
  ["Régénérer la Terre.", "Restaurer les sols, les forêts, les écosystèmes et les liens qui rendent la vie possible."],
  ["Cultiver la coopération.", "Construire avec celles et ceux qui vivent, apprennent, produisent et transmettent sur le territoire."],
  ["Œuvrer pour la paix.", "Prendre soin de la Terre et travailler ensemble pour nourrir des sociétés plus pacifiques."],
  ["Respecter le vivant.", "Protéger la Terre, l'eau, l'air et toutes les formes de vie dont dépend notre avenir commun."],
  ["Transmettre aux générations futures.", "Préserver la beauté et les ressources du monde pour celles et ceux qui viendront après nous."],
];
---

<Layout
  title="Trouver sa place dans le Mouvement — Pachatopia"
  description="Il existe mille façons de contribuer au vivant. Trouvez la forme d'engagement qui vous ressemble avec le Mouvement Pachatopia."
  lang={lang}
>
  <Header lang={lang} />
  <main>
    <section class="relative isolate overflow-hidden py-24 text-white md:py-36">
      <div class="absolute inset-0">
        <img src="/pachatopia/images/aquaculture.webp" alt="" class="h-full w-full object-cover" aria-hidden="true" />
        <div class="absolute inset-0 bg-[linear-gradient(135deg,rgba(14,39,35,0.92),rgba(10,91,75,0.78))]"></div>
      </div>
      <div class="absolute inset-0 -z-0 overflow-hidden" aria-hidden="true">
        <div class="absolute left-[10%] top-12 h-44 w-44 rounded-full bg-white/8 blur-3xl"></div>
        <div class="absolute bottom-0 right-[12%] h-72 w-72 rounded-full bg-golden/15 blur-3xl"></div>
      </div>
      <div class="site-container relative z-10">
        <div class="grid grid-cols-1 gap-12 lg:grid-cols-[1.05fr_0.95fr] lg:items-end">
          <div class="max-w-3xl">
            <div class="section-kicker mb-6 w-fit border-white/15 bg-white/10 text-white shadow-none">
              <LucideIcon name="HeartHandshake" class="h-4 w-4 text-golden" />
              Participer au Mouvement
            </div>
            <h1 class="text-4xl font-heading font-bold leading-tight md:text-5xl lg:text-6xl">Trouver sa place avec le vivant</h1>
            <p class="mt-6 max-w-2xl text-lg leading-8 text-white/85 md:text-xl">Il existe mille façons de contribuer au vivant. Une seule est indispensable : trouver la vôtre.</p>
          </div>

          <div class="lg:justify-self-end">
            <div class="border-t border-white/15 pt-6 text-sm leading-6 text-white/75">
              <p class="font-semibold uppercase tracking-[0.18em] text-white/50">Votre soutien rend possible</p>
              <p class="mt-3 max-w-md">Des arbres plantés, des sols régénérés, des espaces protégés, des rencontres, des apprentissages et une communauté qui grandit.</p>
            </div>
          </div>
        </div>
      </div>
      <svg class="absolute bottom-0 left-0 w-full" viewBox="0 0 1440 80" fill="none" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="none">
        <path d="M0 40C240 80 480 0 720 40C960 80 1200 0 1440 40V80H0V40Z" fill="white"></path>
      </svg>
    </section>

    <section class="bg-white py-20 md:py-28">
      <div class="site-container">
        <div class="grid grid-cols-1 gap-14 lg:grid-cols-[0.8fr_1.2fr] lg:gap-20">
          <div>
            <div class="section-kicker w-fit border-primary/10 bg-primary/[0.03] shadow-none">
              <LucideIcon name="Compass" class="h-4 w-4 text-accent" />
              Pourquoi participer ?
            </div>
            <h2 class="mt-6 text-3xl font-heading font-bold tracking-tight text-primary md:text-4xl">Mettre le meilleur de soi au service du bien commun</h2>
            <div class="mt-6 max-w-md space-y-5 text-lg leading-8 text-gray-700">
              <p>Le vivant nous offre chaque jour l'air que nous respirons, l'eau que nous buvons et les sols qui nous nourrissent.</p>
              <p>À notre tour, nous pouvons choisir d'agir de manière à favoriser son épanouissement. Il n'existe pas une seule manière de contribuer.</p>
            </div>
          </div>

          <div class="relative">
            <div class="absolute bottom-0 left-[1.05rem] top-0 w-px bg-primary/10"></div>
            <div class="space-y-10">
              <article class="relative pl-12">
                <div class="absolute left-0 top-1 flex h-8 w-8 items-center justify-center rounded-full bg-primary text-xs font-semibold text-white">1</div>
                <h3 class="text-2xl font-heading font-bold text-primary">Une communauté qui agit</h3>
                <p class="mt-3 text-lg leading-8 text-gray-700">Pachatopia réunit des femmes et des hommes qui souhaitent reprendre leur juste place dans le vivant.</p>
              </article>
              <article class="relative pl-12">
                <div class="absolute left-0 top-1 flex h-8 w-8 items-center justify-center rounded-full bg-earth text-xs font-semibold text-white">2</div>
                <h3 class="text-2xl font-heading font-bold text-primary">Une diversité de chemins</h3>
                <p class="mt-3 text-lg leading-8 text-gray-700">Chaque arbre planté, chaque idée partagée, chaque rencontre et chaque geste peuvent devenir une graine d'espérance.</p>
              </article>
              <article class="relative pl-12">
                <div class="absolute left-0 top-1 flex h-8 w-8 items-center justify-center rounded-full bg-accent text-xs font-semibold text-white">3</div>
                <h3 class="text-2xl font-heading font-bold text-primary">Une même direction</h3>
                <p class="mt-3 text-lg leading-8 text-gray-700">Nous ne cherchons pas à sauver le vivant de l'extérieur. Nous cherchons à retrouver notre juste place en son sein.</p>
              </article>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="relative isolate overflow-hidden bg-cream py-20 md:py-28">
      <div class="absolute inset-0 -z-10 overflow-hidden" aria-hidden="true">
        <svg class="absolute right-[max(50%,26rem)] top-0 h-[54rem] w-[58rem] translate-x-1/3 text-primary/8 [mask-image:radial-gradient(28rem_28rem_at_top,white,transparent)]" viewBox="0 0 1024 1024" fill="none">
          <defs>
            <pattern id="participation-grid-fr" width="140" height="140" patternUnits="userSpaceOnUse">
              <path d="M140 0H0V140" stroke="currentColor" stroke-width="1" />
            </pattern>
          </defs>
          <rect width="1024" height="1024" fill="url(#participation-grid-fr)" />
        </svg>
      </div>
      <div class="site-container">
        <div class="max-w-3xl">
          <div class="section-kicker w-fit">
            <LucideIcon name="Sprout" class="h-4 w-4 text-accent" />
            Comment souhaitez-vous participer ?
          </div>
          <h2 class="mt-6 text-3xl font-heading font-bold tracking-tight text-primary md:text-4xl">Plusieurs portes d'entrée, une même dynamique de régénération</h2>
          <p class="mt-6 text-lg leading-8 text-gray-700">L'important n'est pas seulement la forme du soutien, mais le fait de participer à un projet qui retisse les liens entre nature, économie, culture et communauté.</p>
        </div>

        <div class="mt-12 grid grid-cols-1 gap-6 md:grid-cols-2 xl:grid-cols-3">
          {participationOptions.map((option) => (
            <a href={option.href} class="group surface-card flex h-full min-h-[17rem] flex-col p-6 no-underline transition-all duration-300 hover:-translate-y-1.5 hover:border-accent/40 hover:shadow-2xl hover:shadow-primary/10">
              <div class="mb-5 flex h-12 w-12 items-center justify-center rounded-2xl bg-primary/10 transition-all duration-300 group-hover:scale-110 group-hover:bg-accent/15">
                <LucideIcon name={option.icon} class="h-6 w-6 text-primary" />
              </div>
              <h3 class="text-xl font-heading font-bold text-primary">{option.title}</h3>
              <p class="mt-3 flex-1 text-sm leading-6 text-gray-700">{option.text}</p>
              <span class="mt-6 inline-flex w-fit items-center gap-2 rounded-full bg-primary/5 px-4 py-2 text-sm font-semibold text-accent transition-all duration-300 group-hover:bg-golden group-hover:text-primary">
                {option.link}
                <LucideIcon name="ArrowRight" class="h-4 w-4 transition-transform duration-300 group-hover:translate-x-1" />
              </span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="bg-primary py-20 text-white md:py-28">
      <div class="site-container">
        <div class="grid grid-cols-1 gap-10 lg:grid-cols-[0.95fr_1.05fr] lg:items-start">
          <div>
            <div class="inline-flex items-center gap-3 rounded-full border border-white/15 bg-white/10 px-4 py-2 text-sm font-medium text-white/90 backdrop-blur">
              <LucideIcon name="ScrollText" class="h-4 w-4 text-golden" />
              La charte Pachatopia
            </div>
            <h2 class="mt-6 max-w-3xl text-3xl font-heading font-bold tracking-tight text-white md:text-4xl lg:text-5xl">Des principes qui donnent une direction claire à notre action</h2>
          </div>

          <div class="space-y-5 text-base leading-7 text-white/78">
            {principles.map(([title, text]) => (
              <p><strong class="text-white">{title}</strong> {text}</p>
            ))}
          </div>
        </div>

        <div class="mt-12 border-t border-white/12 pt-8">
          <p class="max-w-3xl text-lg leading-8 text-white/82">Pachatopia est une aventure humaine et écologique ouverte à tous. Une forêt ne grandit jamais grâce à une seule graine. Un mouvement non plus.</p>
          <p class="mt-4 text-lg font-medium italic text-white">À votre tour de planter une graine d'espérance.</p>
        </div>
      </div>
    </section>

    <section class="relative isolate overflow-hidden bg-white py-20 md:py-28">
      <div class="site-container">
        <div class="mx-auto max-w-3xl text-center">
          <div class="mx-auto mb-6 flex h-14 w-14 items-center justify-center rounded-full bg-golden/15">
            <LucideIcon name="Heart" class="h-7 w-7 text-golden-dark" />
          </div>
          <h2 class="text-3xl font-heading font-bold text-primary md:text-4xl">Rejoignez le Mouvement</h2>
          <p class="mt-6 text-lg leading-8 text-gray-700">Si cette idée résonne en vous, alors peut-être que votre place est déjà en train de vous attendre.</p>
          <div class="mt-8 flex flex-col items-center justify-center gap-4 sm:flex-row">
            <a href="/pachatopia/contacts/" class="button-primary group">
              Nous contacter
              <LucideIcon name="ArrowRight" class="h-5 w-5 transition-transform duration-300 group-hover:translate-x-1" />
            </a>
            <a href="/pachatopia/passeport/" class="link-arrow">
              Découvrir le Passeport
              <LucideIcon name="ArrowRight" class="h-4 w-4" />
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>
  <Footer lang={lang} />
</Layout>
