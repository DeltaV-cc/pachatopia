---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
const lang = "fr";
---
<Layout title="Partager une idee — Pachatopia" description="Le vivant evolue par la diversite. Notre Mouvement aussi." lang={lang}>
  <Header lang={lang} />
  <main>
    <section class="relative text-white py-24 md:py-32 bg-primary">
      <div class="max-w-4xl mx-auto px-4 text-center">
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-heading font-bold mb-6">Partager une idee</h1>
        <p class="text-xl md:text-2xl text-white/90">Le vivant evolue par la diversite. Notre Mouvement aussi.</p>
      </div>
    </section>
  </main>
  <Footer lang={lang} />
</Layout>
