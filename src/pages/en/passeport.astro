---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import CallToAction from "../../components/CallToAction.astro";
const lang = "en";
---
<Layout title="Le Passeport Pachatopia — Pachatopia" description="Devenez Gardien du Vivant" lang={lang}>
  <Header lang={lang} />
  <main>
    <section class="relative text-white py-24 md:py-32 bg-primary">
      <div class="max-w-4xl mx-auto px-4 text-center">
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-heading font-bold mb-6">Le Passeport Pachatopia</h1>
        <p class="text-xl md:text-2xl text-white/90">Devenez Gardien du Vivant</p>
      </div>
    </section>
  </main>
    <CallToAction lang={lang} />
  <Footer lang={lang} />
</Layout>
