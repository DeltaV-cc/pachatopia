---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import UnifiedHomepage from "../components/UnifiedHomepage.astro";

const lang = "fr";
---

<Layout
  title="Pachatopia - Reprendre notre place avec le vivant"
  description="Le Mouvement Pachatopia. Un mouvement de femmes et d'hommes qui choisissent de faire grandir le vivant en eux, autour d'eux et de le transmettre aux générations futures."
  lang={lang}
>
  <Header lang={lang} />
  <UnifiedHomepage lang={lang} />
  <Footer lang={lang} />
</Layout>
